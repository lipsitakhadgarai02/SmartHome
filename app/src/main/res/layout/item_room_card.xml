<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="0dp"
    android:layout_height="180dp"
    android:layout_columnWeight="1"
    android:layout_margin="8dp"
    app:cardCornerRadius="24dp"
    app:cardElevation="0dp">

    <LinearLayout
        android:id="@+id/ll_room_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_room_card"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/iv_room_icon"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:src="@drawable/ic_rooms"
            app:tint="@color/primary_teal" />

        <TextView
            android:id="@+id/tv_room_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="sans-serif-medium"
            android:text="New Room"
            android:textColor="@color/black"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tv_room_category"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Custom Room"
            android:textColor="#707070"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/tv_device_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="3 Devices"
            android:textColor="#A0A0A0"
            android:textSize="9sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <androidx.appcompat.widget.SwitchCompat
                android:id="@+id/switch_room_master"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:thumbTint="@color/white"
                app:trackTint="#E0E0E0" />

            <TextView
                android:id="@+id/tv_status_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="OFF"
                android:textColor="#707070"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>